{
    "admin_users": {
        "description": "🔐 插件管理员列表",
        "type": "list",
        "hint": "输入用户 ID（QQ 号等）。这些用户可以使用插件的管理指令。AstrBot 的全站管理员默认拥有权限，无需在此重复添加",
        "default": null
    },
    "session_defaults": {
        "description": "🛠️ 会话默认配置",
        "type": "object",
        "hint": "这里是对所有会话生效的默认值。私聊与群聊共用同一份配置，会话差异配置请在插件 WebUI 提供的配置管理页面单独覆盖。",
        "items": {
            "enabled": {
                "description": "启用主动消息功能",
                "type": "bool",
                "default": true,
                "hint": "总开关。只有同时出现在下方会话列表中的会话才会获得主动消息服务，避免打扰未配置的会话。"
            },
            "session_list": {
                "description": "会话 UMO 列表",
                "type": "list",
                "default": [],
                "hint": "请输入完整的 UMO，格式为 {平台名}:{消息类型}:{会话ID}，可通过 /sid 指令获取。私聊示例 default:FriendMessage:123456789，群聊示例 default:GroupMessage:987654321。"
            },
            "persona_id": {
                "description": "主动消息专用人格",
                "type": "string",
                "_special": "select_persona",
                "default": "",
                "hint": "留空表示不干预，按“自定义规则 > /persona 会话人格 > 绑定档案默认人格 > 全局默认人格”的顺序自动解析，填写 [%None] 可让主动消息不使用任何人格。会话差异配置中可单独覆盖。"
            },
            "prompt_settings": {
                "description": "🧠 主动消息提示词设置",
                "type": "object",
                "hint": "在这里管理进行主动消息时使用的提示词。",
                "items": {
                    "templates": {
                        "description": "主动消息提示词模板列表",
                        "type": "template_list",
                        "templates": {
                            "prompt_template": {
                                "name": "提示词模板",
                                "hint": "每条模板就是一套完整的主动消息策略：写清这次想怎么开口（行动指南），以及最终要生成什么。启用多条时会先按适用范围筛选，再按权重随机挑一条，适合准备多套不同的话题方向。",
                                "display_item": "name",
                                "items": {
                                    "name": {
                                        "description": "用途名称",
                                        "type": "string",
                                        "default": "",
                                        "hint": "可以给这条模板起个便于识别的名字。"
                                    },
                                    "text": {
                                        "description": "提示词正文",
                                        "type": "text",
                                        "default": "",
                                        "hint": "可以在这调整主动消息的效果。注意此项留空的模板将不会被使用。"
                                    },
                                    "enabled": {
                                        "description": "启用",
                                        "type": "bool",
                                        "default": true
                                    },
                                    "weight": {
                                        "description": "权重",
                                        "type": "int",
                                        "default": 100,
                                        "hint": "多条模板同时启用时按权重随机选取。"
                                    },
                                    "scope": {
                                        "description": "适用范围",
                                        "type": "string",
                                        "options": [
                                            "",
                                            "friend",
                                            "group"
                                        ],
                                        "labels": [
                                            "通用",
                                            "仅私聊",
                                            "仅群聊"
                                        ],
                                        "default": "",
                                        "hint": "「通用」会同时用于私聊与群聊。"
                                    },
                                    "id": {
                                        "description": "模板 ID（内部使用）",
                                        "type": "string",
                                        "default": "",
                                        "invisible": true
                                    }
                                }
                            }
                        },
                        "default": [
                            {
                                "__template_key": "prompt_template",
                                "id": "friend_default",
                                "name": "默认私聊模板",
                                "text": "[行动指南]\n1. 回顾聊天记录，看看你们最后在聊什么。\n2. 如果上次的话题已经聊完了，可以关心一下对方现在在做什么。\n3. 也可以提出一个你一直很好奇的问题。\n4. 如果实在不知道该说什么，直接表达你想他的心情也可以。\n\n[最终指令]\n请综合以上所有信息，用最像你自己的、最自然的方式，生成一句主动聊天的开场白。",
                                "enabled": true,
                                "weight": 100,
                                "scope": "friend"
                            },
                            {
                                "__template_key": "prompt_template",
                                "id": "group_default",
                                "name": "默认群聊模板",
                                "text": "[行动指南]\n1. 回顾群聊记录，看看大家最后在讨论什么有趣的话题，如果没有聊完，尝试延续它。\n2. 向群里的所有人，提出一个开放性的、大家都能参与进来的问题。\n\n[最终指令]\n请综合以上所有信息，用最像你自己的、最自然的方式，生成一句能在群聊中打破僵局、活跃气氛的开场白。",
                                "enabled": true,
                                "weight": 100,
                                "scope": "group"
                            }
                        ]
                    },
                    "output_format": {
                        "description": "主动消息输出格式",
                        "type": "string",
                        "options": [
                            "default",
                            "custom"
                        ],
                        "labels": [
                            "插件默认",
                            "自定义（自己写格式要求）"
                        ],
                        "default": "default",
                        "hint": "管理主动消息的输出格式偏好。"
                    },
                    "output_format_custom": {
                        "description": "自定义格式要求",
                        "type": "text",
                        "default": "",
                        "hint": "仅在输出格式选择「自定义」时生效，会替换插件默认的格式说明。留空则自动退回插件默认格式。可以写允许旁白、动作描写等要求。"
                    }
                }
            },
            "context_settings": {
                "description": "🧩 上下文注入设置",
                "type": "object",
                "items": {
                    "source_mode": {
                        "description": "上下文来源",
                        "type": "string",
                        "options": [
                            "auto",
                            "conversation_history",
                            "platform_message_history",
                            "hybrid"
                        ],
                        "labels": [
                            "自动模式",
                            "当前 AstrBot LLM 对话历史",
                            "平台完整聊天流水",
                            "混合模式"
                        ],
                        "default": "auto",
                        "hint": "自动模式：私聊使用对话历史、群聊使用平台聊天流水，与旧版默认行为一致。当前 AstrBot LLM 对话历史：延续 Bot 与用户已有的对话语境。平台完整聊天流水：参考最近实际聊了什么，更适合群聊。混合模式：同时使用两者，但会占用更多上下文。"
                    },
                    "platform_history_count": {
                        "description": "注入平台聊天流水条数",
                        "type": "int",
                        "default": 50,
                        "hint": "仅在平台聊天流水模式或混合模式下生效。表示最多向模型注入多少条最近的聊天记录。数值越大信息越全，但 token 消耗更高，重点也更容易分散。",
                        "slider": {
                            "min": 0,
                            "max": 1000,
                            "step": 10
                        }
                    },
                    "include_bot_messages": {
                        "description": "是否包含 Bot 自身消息",
                        "type": "bool",
                        "default": true,
                        "hint": "开启后会把 Bot 自己在平台中的历史发言也提供给模型；关闭后只提供用户侧内容。"
                    },
                    "bot_identifiers": {
                        "description": "Bot 标识符列表（逗号分隔）",
                        "type": "string",
                        "default": "bot",
                        "hint": "用于判断平台聊天流水中哪些发言属于 Bot 自己。不同平台记录的名字可能不同，例如 bot、astrbot、assistant。"
                    }
                }
            },
            "schedule_settings": {
                "description": "🕒 发送节奏与免打扰",
                "type": "object",
                "hint": "这里是唯一决定「什么时候真正发出去」的配置组。「启动检测」和「群聊沉默」只负责决定何时开始安排，不决定发送时刻。",
                "items": {
                    "min_delay_minutes": {
                        "description": "最短发送延迟（分钟）",
                        "type": "int",
                        "default": 30,
                        "hint": "每次安排主动消息时，会在「最短～最长」之间随机取一个值作为真实发送时刻。这个值是最短边界，防止过于频繁地打扰。",
                        "slider": {
                            "min": 1,
                            "max": 2880,
                            "step": 30
                        }
                    },
                    "max_delay_minutes": {
                        "description": "最长发送延迟（分钟）",
                        "type": "int",
                        "default": 600,
                        "hint": "随机区间的上限，确保 Bot 不会太久不说话。若小于最短延迟，会自动按最短延迟处理。",
                        "slider": {
                            "min": 1,
                            "max": 2880,
                            "step": 30
                        }
                    },
                    "quiet_hours_enabled": {
                        "description": "启用免打扰时段",
                        "type": "bool",
                        "default": true,
                        "hint": "关闭后将忽略下方免打扰时段，全天候允许发送。"
                    },
                    "quiet_hours": {
                        "description": "免打扰时段（24 小时制）",
                        "type": "string",
                        "default": "1-7",
                        "hint": "支持多个时段，用逗号或顿号分隔，例如 23-7, 12-14、18-20。23-7 表示晚上 11 点到次日早上 7 点；在这些时间段内不会发送主动消息。仅在启用免打扰时段时生效。"
                    },
                    "max_unanswered_times": {
                        "description": "最大未回复次数上限",
                        "type": "int",
                        "default": 4,
                        "hint": "连续发送 N 次主动消息都没有得到回复后，将暂停主动消息，直到再次有新消息。填 0 表示不限制。",
                        "slider": {
                            "min": 0,
                            "max": 20,
                            "step": 1
                        }
                    }
                }
            },
            "startup_check_settings": {
                "description": "🤖 启动后检测（自动主动消息）",
                "type": "object",
                "hint": "本配置组用于插件启动后自动判断「什么时候开始安排一次主动消息」，保证插件重载对于进行主动消息的用户无感，但不决定何时发送。",
                "items": {
                    "enabled": {
                        "description": "启用启动后检测（自动主动消息）",
                        "type": "bool",
                        "default": false,
                        "hint": "插件启动后，若某个会话持续没有新消息，就自动为它安排一次主动消息。用于避免插件重启后用户不发消息导致的主动消息中断。"
                    },
                    "after_silence_minutes": {
                        "description": "静默检测窗口（分钟）",
                        "type": "int",
                        "default": 5,
                        "hint": "插件启动后，若该会话连续 N 分钟一直没有新消息，且当前没有待执行的主动消息任务，就创建一次待执行的主动消息任务。注意：实际发送时间还要叠加「发送节奏」里的随机延迟。",
                        "slider": {
                            "min": 1,
                            "max": 1440,
                            "step": 10
                        }
                    }
                }
            },
            "group_silence_settings": {
                "description": "🕊️ 群聊沉默破冰",
                "type": "object",
                "hint": "此配置组仅对群聊会话生效，私聊会忽略。它只决定何时开始安排，不决定发送时刻。",
                "items": {
                    "idle_minutes": {
                        "description": "沉默判定时长（分钟）",
                        "type": "int",
                        "default": 30,
                        "hint": "群聊中连续 N 分钟没有人发言后，才开始安排一次主动消息。注意：实际发送时间还要叠加「发送节奏」里的随机延迟。",
                        "slider": {
                            "min": 1,
                            "max": 1440,
                            "step": 10
                        }
                    }
                }
            },
            "segmented_reply_settings": {
                "description": "🔪 分段回复设置",
                "type": "object",
                "items": {
                    "enabled": {
                        "description": "启用分段回复",
                        "type": "bool",
                        "default": false,
                        "hint": "开启后，回复文本会被切分为多条短消息发送。"
                    },
                    "words_count_threshold": {
                        "description": "不分段字数阈值",
                        "type": "int",
                        "default": 80,
                        "hint": "回复内容字数超过此值时不再分段。",
                        "slider": {
                            "min": 0,
                            "max": 1024,
                            "step": 2
                        }
                    },
                    "split_mode": {
                        "description": "分段模式",
                        "type": "string",
                        "options": [
                            "regex",
                            "words"
                        ],
                        "default": "regex",
                        "labels": [
                            "正则表达式",
                            "分段词列表"
                        ]
                    },
                    "regex": {
                        "description": "分段正则表达式",
                        "type": "string",
                        "default": ".*?[。？！~…\\n]+|.+$",
                        "condition": {
                            "split_mode": "regex"
                        }
                    },
                    "split_words": {
                        "description": "分段词列表",
                        "type": "list",
                        "default": [
                            "。",
                            "？",
                            "！",
                            "~",
                            "…"
                        ],
                        "condition": {
                            "split_mode": "words"
                        },
                        "hint": "检测到列表中的任意词时进行分段。"
                    },
                    "content_cleanup_enabled": {
                        "description": "启用内容过滤",
                        "type": "bool",
                        "default": true,
                        "hint": "开启后，将在每个分段发送前按下方正则移除匹配内容。仅 AstrBot >= v4.20.1 需要开启。"
                    },
                    "content_cleanup_rule": {
                        "description": "内容过滤正则表达式",
                        "type": "string",
                        "default": "[\\n\u200B]",
                        "hint": "移除分段内容中的指定内容。例如填写 [。？！] 会移除所有的句号、问号、感叹号。",
                        "condition": {
                            "content_cleanup_enabled": true
                        }
                    },
                    "interval_method": {
                        "description": "间隔计算方法",
                        "type": "string",
                        "options": [
                            "random",
                            "log"
                        ],
                        "default": "log",
                        "labels": [
                            "随机",
                            "对数计算"
                        ],
                        "hint": "随机：在随机间隔（秒）内随机；对数计算：按字数计算 y=log_base(x)。"
                    },
                    "interval": {
                        "description": "随机间隔（秒）",
                        "type": "string",
                        "default": "1.5, 3.5",
                        "condition": {
                            "interval_method": "random"
                        },
                        "hint": "格式为「最小, 最大」，例如 1.5, 3.5。"
                    },
                    "log_base": {
                        "description": "对数底数",
                        "type": "string",
                        "default": "1.8",
                        "condition": {
                            "interval_method": "log"
                        }
                    }
                }
            },
            "tts_settings": {
                "description": "🔊 语音合成设置",
                "type": "object",
                "items": {
                    "enabled": {
                        "description": "启用 TTS",
                        "type": "bool",
                        "default": false,
                        "hint": "开启后，主动消息会尝试生成语音并发送。"
                    },
                    "always_send_text": {
                        "description": "发送语音后附带原文",
                        "type": "bool",
                        "default": true,
                        "hint": "开启后，即使语音发送成功，也会再发一条纯文本原文，确保内容可见。"
                    }
                }
            }
        }
    },
    "web_admin": {
        "description": "🌐 Web 管理端设置",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用 Web 管理端",
                "type": "bool",
                "default": true,
                "hint": "启用后会启动主动消息插件的独立 WebUI 管理端。"
            },
            "host": {
                "description": "监听地址",
                "type": "string",
                "default": "127.0.0.1",
                "hint": "默认仅本机访问；如需局域网访问可改为 0.0.0.0。"
            },
            "port": {
                "description": "监听端口",
                "type": "int",
                "default": 4100,
                "slider": {
                    "min": 1024,
                    "max": 65535,
                    "step": 1
                }
            },
            "password": {
                "description": "访问密码（留空则无需登录）",
                "type": "string",
                "default": "",
                "hint": "建议生产环境设置强密码。"
            }
        }
    },
    "notification_settings": {
        "description": "🔔 通知系统设置",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用通知系统",
                "type": "bool",
                "default": true,
                "hint": "启用后，插件会定时从远端通知平台拉取通知并同步到 Web 管理端。"
            },
            "poll_interval_seconds": {
                "description": "通知轮询间隔（秒）",
                "type": "int",
                "default": 300,
                "hint": "插件向远端通知平台轮询更新的时间间隔，最低按 30 秒处理。",
                "slider": {
                    "min": 30,
                    "max": 3600,
                    "step": 10
                }
            }
        }
    },
    "telemetry_config": {
        "description": "📡 遥测设置",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用匿名遥测",
                "type": "bool",
                "default": true,
                "hint": "启用后，插件会匿名上报配置统计与错误信息，用于帮助改进插件。不会上报会话列表、提示词和密码等敏感信息。"
            }
        }
    },
    "legacy_type_fallback": {
        "description": "旧版类型差异（迁移用，请勿手动修改）",
        "type": "dict",
        "default": null,
        "invisible": true,
        "hint": "承载旧版私聊/群聊配置中确实存在差异的那部分值。运行时会按会话类型自动合入，新安装用户不会产生本字段。"
    },
    "friend_settings": {
        "description": "旧版私聊配置（迁移用，请勿手动修改）",
        "type": "dict",
        "default": null,
        "invisible": true,
        "hint": "v1.3 起已合并到 session_defaults。保留声明只为让旧数据能被迁移器读取，迁移完成后可删除。"
    },
    "group_settings": {
        "description": "旧版群聊配置（迁移用，请勿手动修改）",
        "type": "dict",
        "default": null,
        "invisible": true,
        "hint": "v1.3 起已合并到 session_defaults。保留声明只为让旧数据能被迁移器读取，迁移完成后可删除。"
    }
}
